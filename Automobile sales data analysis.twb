    <worksheet name='Revenue % by Country (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#aa5500' fontsize='9'>Total Revenue Percentage by Country</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Key finding</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>The </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>United States is the largest market</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>, generating approximately </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>$30.60M</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Australia is second with approximately </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>$25.30M</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Together:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>United States + Australia ≈ $55.90M</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>That&apos;s roughly </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>59% of total revenue</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Strategic implication</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>The business is heavily dependent on the US and Australian markets.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Management should:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Protect these high-performing markets. </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Investigate what makes these markets successful. </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Look for opportunities to increase sales in Canada, France and Germany. </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Compare product preferences between countries.</run>
          </formatted-text>
        </caption>
      </layout-options>
