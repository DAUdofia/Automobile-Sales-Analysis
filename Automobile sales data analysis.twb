    <worksheet name='Profit Margin by Category'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#aa5500' fontsize='9'>Profit Margin by Category</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Important insight</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Bikes drive revenue, but Accessories drive margin.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>This gives you an excellent Tableau storytelling point:</run>
            <run lmargin='600' rmargin='600'>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' lmargin='600' rmargin='600'>&quot;The company relies on Bikes for revenue but Accessories for profitability.&quot;</run>
          </formatted-text>
        </caption>
      </layout-options>
