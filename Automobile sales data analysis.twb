    <worksheet name='TR by Customer Segment'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#aa5500' fontsize='9'>Total Revenue by Customer Segment</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Key finding</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>The </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>17–29 age group is the largest contributor</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>, generating approximately:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>$34.47M</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>That&apos;s about </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>36% of total revenue</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>The </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>17–49 age range combined</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> contributes approximately:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>$63.27M</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>or about </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>67% of total revenue</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Major customer insight</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>The company&apos;s core customer base is clearly concentrated among </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>17–49-year-olds</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>This suggests marketing campaigns should heavily consider:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Working professionals </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Young adults </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Recreational cyclists </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Fitness-oriented customers </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Customers with relatively high purchasing activity</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Auto mobile sales (AUTO-MOBILE SALES DATA)' name='federated.0d27nl80ngdcy911479fw1omp0o5' />
          </datasources>
