  <worksheets>
    <worksheet name='AVG P PER CAT.'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#aa5500' fontsize='9'>Average Sales Price Per Category</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Key finding</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Bikes have by far the highest average selling price at approximately $1,901.70 per unit.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>However, Accessories have the </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>highest profit margin at 62.57%</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>, despite their much lower unit price.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>This is an important business insight:</run>
            <run lmargin='600' rmargin='600'>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' lmargin='600' rmargin='600'>High selling price does not necessarily mean high profitability.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Bikes generate approximately </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>73% of total revenue</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>, making them the company&apos;s major revenue driver, but Accessories are considerably more profitable as a percentage of revenue.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Auto mobile sales (AUTO-MOBILE SALES DATA)' name='federated.0d27nl80ngdcy911479fw1omp0o5' />
          </datasources>
          <datasource-dependencies datasource='federated.0d27nl80ngdcy911479fw1omp0o5'>
            <column caption='Customer Segment' datatype='string' name='[Calculation_1118018651514818560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF[Customer_Age]&lt;17 THEN&quot;Teenagers (15-16)&quot;&#13;&#10;ELSEIF [Customer_Age]&lt;30 THEN&quot;Young Adults (17-29)&quot;&#13;&#10;ELSEIF [Customer_Age]&lt;50 THEN&quot;Adults (30-49)&quot;&#13;&#10;ELSEIF [Customer_Age]&lt;70 THEN&quot;Middle Aged (50-69)&quot;&#13;&#10;ELSE&quot;Elderly (70-99)&quot;&#13;&#10;END' />
            </column>
            <column caption='PROFIT MARGIN' datatype='real' datatype-customized='true' name='[Calculation_1118018651524763651]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Profit])/SUM([Total Revenue])' />
            </column>
            <column caption='Customer Age' datatype='integer' name='[Customer_Age]' role='measure' type='quantitative' />
            <column caption='Customer Gender' datatype='string' name='[Customer_Gender]' role='dimension' type='nominal' />
            <column aggregation='None' caption='Country' datatype='string' name='[Location - Split 1]' role='dimension' semantic-role='[Country].[Name]' type='nominal' user:SplitFieldIndex='1' user:SplitFieldOrigin='[federated.0d27nl80ngdcy911479fw1omp0o5].[Location]'>
